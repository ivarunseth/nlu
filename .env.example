# Copy to .env. Loaded by python-dotenv for the host processes and by
# docker-compose.yml (env_file + ${VAR} interpolation) for the containers.
# Compose overrides the host-specific values (Redis, database) per service,
# so the same .env serves both ways of running the stack, except PUBLIC_URL
# (see below).

# Interactive debugger and reloader. Host development only; compose forces
# it off.
FLASK_DEBUG=true

# Port `python app.py` listens on (containers always bind 5000). The Vite
# dev server proxies to it.
PORT=5000

# Signs user sessions and deployment API keys. Change it.
SECRET_KEY=change-me

# ── Database ─────────────────────────────────────────────────
# Host processes: relative sqlite paths resolve under ./instance.
SQLALCHEMY_DATABASE_URI=sqlite:///indicnlu.db
# Training/serving task results (history the UI reads). Not named
# CELERY_RESULT_BACKEND on purpose: Celery would let that env var override
# every app's backend, including the request worker's.
TASK_RESULT_BACKEND=db+sqlite:///instance/indicnlu.db

# Compose: credentials for the postgres service; the backend URIs are
# derived from these.
POSTGRES_USER=indicnlu
POSTGRES_PASSWORD=indicnlu
POSTGRES_DB=indicnlu

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/0
SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/0
# Results of long-running HTTP requests replayed by the request worker:
# fetched once, then expire (REQUEST_RESULT_TTL, seconds).
REQUEST_RESULT_BACKEND=redis://localhost:6379/1
REQUEST_RESULT_TTL=3600
# Per-environment inference registries. Default: the same Redis for both
# (compose points them at its redis service). Set them to separate
# instances to isolate the environments.
# REDIS_URL_TESTING=redis://localhost:6379/0
# REDIS_URL_PRODUCTION=redis://localhost:6379/0

# ── Storage ──────────────────────────────────────────────────
# `local` writes artifacts under ./<STORAGE_BUCKET> (a shared volume in
# compose). Other providers: s3, gcs, azure, minio, ftp, sftp, akamai.
STORAGE_PROVIDER=local
STORAGE_BUCKET=data
# Provider credentials, read by server/storage/<provider>.py when selected:
#   s3     AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION
#   minio  MINIO_URL, MINIO_ACCESS_KEY, MINIO_SECRET_KEY
#   azure  AZURE_CONNECTION_STRING, or AZURE_ACCOUNT_NAME + AZURE_ACCOUNT_KEY
#   ftp    FTP_HOST, FTP_USER, FTP_PASS
#   sftp   SFTP_HOST, SFTP_USER, SFTP_KEY, SFTP_KNOWNHOSTS
#   akamai NETSTORAGE_HOSTNAME, NETSTORAGE_KEYNAME, NETSTORAGE_KEY, NETSTORAGE_CPCODE

# ── Serving ──────────────────────────────────────────────────
# Defaults for every new deployment's config; the Publish tab edits them
# per deployment afterwards. Seconds unless noted.
# How long the infer view waits for a prediction. Also the wait on a cold
# model's first requests, so it must cover artifact download + load on
# the host (INFERENCE_BATCH_TIMEOUT below is only the fallback when a
# route carries no timeout of its own).
#INFERENCE_REQUEST_TIMEOUT=30
#INFERENCE_POLL_INTERVAL=0.01
#INFERENCE_BATCH_SIZE=32
#INFERENCE_SLEEP=0.005
#INFERENCE_IDLE_TIMEOUT=300
#INFERENCE_HEARTBEAT_INTERVAL=5
#INFERENCE_OUTPUT_TTL=300
# Process-wide, not per deployment.
#INFERENCE_BATCH_TIMEOUT=120
#INFERENCE_START_TTL=120
#INFERENCE_MAX_BATCH=256
# Deployment API-key lifetime per environment (seconds).
#INFERENCE_API_KEY_TTL_TESTING=43200
#INFERENCE_API_KEY_TTL_PRODUCTION=2592000

# ── Training ─────────────────────────────────────────────────
# Expand NER/NLU datasets through the entity value catalogues (a run can
# override this with its `augment` option).
#AUGMENT_ENABLED=true
#AUGMENT_UNK_TOKEN=[UNK]

# ── Analytics ────────────────────────────────────────────────
# The telemetry consumer in the analytics service: rows per insert, poll
# interval (seconds) and how long predictions are kept (days).
#TELEMETRY_BATCH_SIZE=100
#TELEMETRY_INTERVAL=1.0
#TELEMETRY_RETENTION_DAYS=30
# Rows per batch for dataset import/export.
#DATASET_IO_BATCH_SIZE=5000

# ── Public address ───────────────────────────────────────────
# The URL users reach the UI on. Deployment endpoints are
# PUBLIC_URL/api/inference/<environment>/<model_id>, and the browser calls
# them as absolute URLs. This is the one value that differs between the two
# ways of running the stack:
#   host development  -> the Vite origin; it proxies /api to python app.py
#   docker compose    -> the name users reach nginx on, e.g. http://localhost
#                        locally or http://nlu.example.com on a real host
PUBLIC_URL=http://localhost:5173

# Port nginx publishes the UI on (compose only).
CLIENT_PORT=80

# ── Containers ───────────────────────────────────────────────
# Image name prefix and tag (compose + docker-bake.hcl). Empty REGISTRY
# means plain local tags, e.g. api:latest.
REGISTRY=
TAG=latest
# cpu | cuda — which worker image variant compose builds and runs. The CUDA
# host uses docker-compose.gpu.yml, which forces cuda.
WORKER_DEVICE=cpu
# gunicorn worker processes per inference-api-<environment> service.
INFERENCE_WORKERS=2
# prefork processes in the request worker (one long-running request each),
# and how many requests each child replays before it is recycled.
REQUEST_WORKERS=2
#REQUEST_MAX_TASKS_PER_CHILD=50
# Celery monitoring UI. Published on loopback only unless FLOWER_BIND is
# 0.0.0.0 — do that only together with FLOWER_BASIC_AUTH=user:password,
# because without credentials flower's API (task submit, worker shutdown)
# is open to whoever reaches the port.
FLOWER_BIND=127.0.0.1
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=
