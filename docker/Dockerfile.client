# Static SPA behind nginx. The build stage runs Vite; the runtime stage is
# nginx with nginx.conf, which serves the built UI and proxies
# /api/<blueprint>/ to the service of that name (inference per environment:
# /api/inference/<environment>/ -> inference-<environment>) and /socket.io/
# to events; see nginx.conf.

FROM node:22-bookworm-slim AS build

WORKDIR /app
ENV PATH="/app/node_modules/.bin:${PATH}"

COPY package*.json ./
RUN npm ci

COPY vite.config.js index.html ./
COPY src/ ./src/
COPY public/ ./public/

RUN npm run build


FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
